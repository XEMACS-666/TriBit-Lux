	(text "CUMULATIVE THRESHOLD INDICATORS"
		(exclude_from_sim no)
		(at 224.79 93.98 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "022945c8-514c-464f-9ecb-394d0ec25555")
	)
	(text "U7 isolates the LM339 outputs from LED current.\nHIGH = threshold crossed; LEDs accumulate from D1 to D7.\nBoth output enables are LOW. Unused input is grounded."
		(exclude_from_sim no)
		(at 224.79 100.33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c99f42a-8876-4062-884a-9eda5fd39f45")
	)
	(text "LEVEL 4"
		(exclude_from_sim no)
		(at 356.87 158.75 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "37073259-924a-4dfc-9fa8-613f21bd8e2a")
	)
	(text "LEVEL 3"
		(exclude_from_sim no)
		(at 356.87 143.51 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "3dc21f80-a5b9-402e-9617-170e9149e488")
	)
	(text "XEMACS | 5V logic, regulated 2.5V sensor / resistor ladder.\nNominal thresholds: 0.3125, 0.625, 0.9375, 1.250, 1.5625, 1.875, 2.1875V.\nComparator pull-ups: R17-R24 = 2.2k. All support resistors and capacitors use hand-solderable 0805 footprints.\nMCP1700: pin 1 GND, pin 2 VIN, pin 3 VOUT. C5/C6: 2.2uF X7R,16V; effective capacitance >=1uF.\nCore ADC / display / ladder / controls remain through-hole. U7 and level LEDs are surface mount.\nUnfabricated design draft. LED levels indicate voltage thresholds; ambient lux is not calibrated."
		(exclude_from_sim no)
		(at 57.15 64.516 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3dd4c850-d55c-415e-91cd-050a7ec02b83")
	)
